@model RaceDay.Mvc.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="mb-4">
                <h2 class="fw-bold">Create Category</h2>
                <p class="text-muted">
                    Add a new race category to RaceDay.
                </p>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.ErrorMessage
                        </div>
                    }

                    <form asp-controller="Organiser"
                          asp-action="CreateCategory"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryName"
                                   class="form-label">
                                Category Name
                            </label>

                            <input asp-for="CategoryName"
                                   class="form-control"
                                   placeholder="e.g. 10 km Road Race" />

                            <span asp-validation-for="CategoryName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DistanceKM"
                                   class="form-label">
                                Distance (Kilometres)
                            </label>

                            <input asp-for="DistanceKM"
                                   type="number"
                                   step="0.1"
                                   min="0.1"
                                   class="form-control"
                                   placeholder="e.g. 10" />

                            <span asp-validation-for="DistanceKM"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryType"
                                   class="form-label">
                                Category Type
                            </label>

                            <select asp-for="CategoryType"
                                    class="form-select">
                                <option value="">Select category type</option>
                                <option value="Run">Run</option>
                                <option value="Walk">Walk</option>
                                <option value="Cycle">Cycle</option>
                            </select>

                            <span asp-validation-for="CategoryType"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe this race category">
                            </textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Organiser"
                               asp-action="Categories"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Create Category
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
