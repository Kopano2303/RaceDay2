@model List<RaceDay.Mvc.ViewModels.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
    Layout = "_Layout";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold">Manage Categories</h2>
            <p class="text-muted">
                View and manage race categories.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Organiser"
               asp-action="EventCategories"
               class="btn btn-outline-secondary">
                View Event Categories
            </a>

            <a asp-controller="Organiser"
               asp-action="CreateEventCategory"
               class="btn btn-outline-primary">
                Link to Event
            </a>

            <a asp-controller="Organiser"
               asp-action="CreateCategory"
               class="btn btn-primary">
                + Create Category
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h5>No categories found</h5>

                <p class="text-muted">
                    Create your first category to get started.
                </p>

                <a asp-controller="Organiser"
                   asp-action="CreateCategory"
                   class="btn btn-primary">
                    Create First Category
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Category</th>
                            <th>Distance</th>
                            <th>Type</th>
                            <th>Description</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @category.CategoryName
                                </td>

                                <td>
                                    @category.DistanceKM km
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @category.CategoryType
                                    </span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(category.Description)
                                                                ? "No description"
                                                                : category.Description)
                        </td>
                    </tr>
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

