@model RaceDay.Mvc.ViewModels.CreateResultViewModel

@{
    ViewData["Title"] = "Record Race Result";
    Layout = "_Layout";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Record Race Result</h2>
        <p class="text-muted">
            Enter the participant's finishing time and race position.
        </p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="Organiser"
                  asp-action="CreateResult"
                  asp-route-eventId="@ViewBag.EventID"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="EnrolmentID" class="form-label">
                        Participant
                    </label>

                    <select asp-for="EnrolmentID"
                            class="form-select">
                        <option value="0">Select a participant</option>

                        @foreach (var enrolment in Model.Enrolments)
                        {
                            <option value="@enrolment.EnrolmentID">
                                @enrolment.ParticipantName -
                                @enrolment.CategoryName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="EnrolmentID"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FinishTime" class="form-label">
                        Finish Time
                    </label>

                    <input asp-for="FinishTime"
                           type="time"
                           step="1"
                           class="form-control" />

                    <span asp-validation-for="FinishTime"
                          class="text-danger"></span>

                    <small class="text-muted">
                        Enter the finishing time in hours, minutes and seconds.
                    </small>
                </div>

                <div class="mb-3">
                    <label asp-for="OverallPosition" class="form-label">
                        Overall Position
                    </label>

                    <input asp-for="OverallPosition"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="e.g. 1" />

                    <span asp-validation-for="OverallPosition"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryPosition" class="form-label">
                        Category Position
                    </label>

                    <input asp-for="CategoryPosition"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="e.g. 1" />

                    <span asp-validation-for="CategoryPosition"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Status" class="form-label">
                        Result Status
                    </label>

                    <select asp-for="Status" class="form-select">
                        <option value="Finished">Finished</option>
                        <option value="Did Not Finish">Did Not Finish</option>
                        <option value="Disqualified">Disqualified</option>
                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Result
                    </button>

                    <a asp-controller="Organiser"
                       asp-action="EventResults"
                       asp-route-eventId="@ViewBag.EventID"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
