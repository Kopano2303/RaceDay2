@{
    ViewData["Title"] = "Participant Dashboard";
    Layout = "_Layout";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Welcome to RaceDay!</h2>
        <p class="text-muted">
            Hello, @ViewBag.UserName!
            Discover events, manage your enrolments and track your results.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Discover Events</h5>
                    <p class="text-muted">
                        Explore upcoming running, walking and cycling events.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="Events"
                       class="btn btn-primary">
                        Browse Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">My Enrolments</h5>
                    <p class="text-muted">
                        View the events you have registered for.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="MyEnrolments"
                       class="btn btn-primary">
                        View Enrolments
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">My Results</h5>
                    <p class="text-muted">
                        Track your performance and race achievements.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="MyResults"
                       class="btn btn-primary">
                        View Results
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">My Profile</h5>
                    <p class="text-muted">
                        Update your personal information and profile picture.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="Profile"
                       class="btn btn-primary">
                        Manage Profile
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
