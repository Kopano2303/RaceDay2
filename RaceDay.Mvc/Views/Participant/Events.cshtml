@model List<RaceDay.Mvc.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Discover Events";
    Layout = "_Layout";
}

<div class="container py-5">

    <div class="mb-4">
        <h2 class="fw-bold">Discover RaceDay Events</h2>
        <p class="text-muted">
            Find your next running, walking or cycling challenge.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (ViewBag.CategoryErrorMessage != null)
    {
        <div class="alert alert-warning">
            @ViewBag.CategoryErrorMessage
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No events are currently available.
            Please check again later.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">

                <h5 class="fw-bold mb-3">Find an Event</h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label for="eventSearch" class="form-label">
                            Search events
                        </label>

                        <input type="text"
                               id="eventSearch"
                               class="form-control"
                               placeholder="Search by event name, venue or city..." />
                    </div>

                    <div class="col-md-4">
                        <label for="eventTypeFilter" class="form-label">
                            Event type
                        </label>

                        <select id="eventTypeFilter" class="form-select">
                            <option value="">All event types</option>
                            <option value="running">Running</option>
                            <option value="walking">Walking</option>
                            <option value="cycling">Cycling</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="button"
                                id="clearFilters"
                                class="btn btn-outline-secondary w-100">
                            Clear Filters
                        </button>
                    </div>

                </div>

                <div class="mt-3 text-muted">
                    <span id="eventCount">@Model.Count</span> event(s) found
                </div>

            </div>
        </div>

        <div class="row g-4" id="eventList">

            @foreach (var eventItem in Model)
            {
                <div class="col-md-6 col-lg-4 event-card"
                     data-name="@eventItem.EventName.ToLower()"
                     data-venue="@eventItem.Venue.ToLower()"
                     data-city="@eventItem.City.ToLower()"
                     data-type="@eventItem.EventType.ToLower()">

                    <div class="card shadow-sm border-0 h-100">

                        <div class="card-body p-4 d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <span class="badge bg-primary">
                                    @eventItem.EventType
                                </span>

                                @if (eventItem.Status.Equals("Open", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success">Open</span>
                                }
                                else if (eventItem.Status.Equals("Upcoming", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-info text-dark">Upcoming</span>
                                }
                                else if (eventItem.Status.Equals("Closed", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-secondary">Closed</span>
                                }
                                else if (eventItem.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @eventItem.Status
                                    </span>
                                }

                        </div>

                        <h5 class="fw-bold">
                            @eventItem.EventName
                        </h5>

                        <p class="text-muted">
                            @(string.IsNullOrWhiteSpace(eventItem.Description)
                                                    ? "Join this RaceDay event and take on a new challenge."
                                                    : eventItem.Description)
                    </p>

                            <hr />

                            <div class="mb-3">

                                <p class="mb-2">
                                    <strong>Date:</strong>
                                    @eventItem.EventDate.ToString("dd MMMM yyyy")
                                </p>

                                <p class="mb-2">
                                    <strong>Start time:</strong>
                                    @eventItem.StartTime.ToString(@"hh\:mm")
                                </p>

                                <p class="mb-2">
                                    <strong>Venue:</strong>
                                    @eventItem.Venue
                                </p>

                                <p class="mb-2">
                                    <strong>Location:</strong>
                                    @eventItem.City, @eventItem.Province
                                </p>

                            </div>

                            <hr />

                            <h6 class="fw-bold mb-3">Available Categories</h6>

                    @if (eventItem.Categories == null ||
                                        eventItem.Categories.Count == 0)
                            {
                                <p class="text-muted">
                                    No categories have been added to this event yet.
                                </p>
                            }
                            else
                            {
                                @foreach (var category in eventItem.Categories)
                                {
                                    <div class="border rounded p-3 mb-3">

                                        <h6 class="fw-bold">
                                            @category.CategoryName
                                        </h6>

                                        <p class="mb-1">
                                            <strong>Entry fee:</strong>
                                            R @category.EntryFee.ToString("N2")
                                        </p>

                                        <p class="mb-3">
                                            <strong>Maximum participants:</strong>
                                            @(category.MaximumParticipants?.ToString() ?? "Unlimited")
                                        </p>

                                        @if (eventItem.Status.Equals("Open", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form asp-controller="Participant"
                                                  asp-action="Enrol"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="eventCategoryId"
                                                       value="@category.EventCategoryID" />

                                                <button type="submit"
                                                        class="btn btn-primary w-100">
                                                    Enrol Now
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-secondary w-100"
                                                    disabled>
                                                Enrolment Unavailable
                                            </button>
                                        }

                                    </div>
                                }
                            }

                        </div>

                    </div>

                </div>
            }

        </div>

        <div id="noEventsFound"
             class="alert alert-info text-center mt-4"
             style="display: none;">
            No events match your search. Try changing your filters.
        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("eventSearch");
            const typeFilter = document.getElementById("eventTypeFilter");
            const clearButton = document.getElementById("clearFilters");
            const eventCards = document.querySelectorAll(".event-card");
            const eventCount = document.getElementById("eventCount");
            const noEventsFound = document.getElementById("noEventsFound");

            function filterEvents() {

                const searchValue = searchInput.value.toLowerCase().trim();
                const selectedType = typeFilter.value.toLowerCase();

                let visibleCount = 0;

                eventCards.forEach(function (card) {

                    const name = card.dataset.name;
                    const venue = card.dataset.venue;
                    const city = card.dataset.city;
                    const type = card.dataset.type;

                    const matchesSearch =
                        name.includes(searchValue) ||
                        venue.includes(searchValue) ||
                        city.includes(searchValue);

                    const matchesType =
                        selectedType === "" ||
                        type.includes(selectedType);

                    if (matchesSearch && matchesType) {
                        card.style.display = "";
                        visibleCount++;
                    } else {
                        card.style.display = "none";
                    }

                });

                eventCount.textContent = visibleCount;

                noEventsFound.style.display =
                    visibleCount === 0 ? "block" : "none";
            }

            searchInput.addEventListener("input", filterEvents);
            typeFilter.addEventListener("change", filterEvents);

            clearButton.addEventListener("click", function () {
                searchInput.value = "";
                typeFilter.value = "";
                filterEvents();
            });

        });
    </script>
}

